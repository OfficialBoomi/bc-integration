# Boomi Platform Credentials
BOOMI_API_URL=https://api.boomi.com
BOOMI_USERNAME=your.email@company.com
BOOMI_API_TOKEN=generate_from_boomi_platform
BOOMI_ACCOUNT_ID=your_account_id
BOOMI_VERIFY_SSL=true

# Target Folder (your agent can help you set up a folder in platform if you need)
BOOMI_TARGET_FOLDER=folder_guid_here

# Deployment
BOOMI_ENVIRONMENT_ID=environment_guid
BOOMI_TEST_ATOM_ID=atom_guid

# Optional: Shared Web Server
# Valid Server Auth Types: basic | bearer | none.
SERVER_AUTH_TYPE=basic
SERVER_BASE_URL=https://your-atom.integrate.boomi.com
SERVER_USERNAME=
SERVER_TOKEN=
SERVER_BEARER_TOKEN=
SERVER_VERIFY_SSL=false

# Optional: Partner / Sub-Account
# Manage a sub-account from a parent partner account.
# BOOMI_ACCOUNT_ID above must be the parent account; API token must come from it.
# Both variables must be set together. One sub-account at a time.
# PARTNER_OVERRIDE=true
# PARTNER_SUB_ACCOUNT=sub_account_id

# Activity logging (opt-in). Writes script operations to .activity-log/activity.jsonl locally.
# BOOMI_COMPANION_LOG_ACTIVITY=1
